{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(cadastrar|login|horarios|avisos)(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/",
      "status": 301,
      "headers": { "Location": "/login.html" }
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}